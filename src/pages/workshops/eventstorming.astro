---
import BackToTop from '../../components/BackToTop.astro';
import BaseHead from '../../components/BaseHead.astro';
import Button from '../../components/Button.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import Section from '../../components/Section.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import { SITE_TITLE } from '../../consts';
import { eventstorming, registrationUrl } from '../../data/workshops';

const title = `${eventstorming.title} | ${SITE_TITLE}`;
const description = "Master the art of collaborative domain discovery. Learn Big Picture EventStorming, Process Modeling, Software Design, and facilitation practice in this hands-on virtual workshop.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="bg-white">
		<Header />

		<!-- Hero -->
		<section class="relative w-full overflow-hidden" style="height: 360px;">
			<div class="absolute inset-0 w-full h-full">
				<img
					src="/images/eventstorming-wall.webp"
					alt="EventStorming workshop wall covered in sticky notes"
					class="w-full h-full object-cover"
					style="filter: brightness(0.6); object-position: center 40%;"
				/>
				<div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/30 to-black/50"></div>
			</div>
			<div class="relative z-10 flex items-center justify-center h-full">
				<div class="max-w-screen-xl mx-auto px-6 w-full">
					<div class="text-center max-w-4xl mx-auto">
						<h1 class="text-5xl md:text-7xl font-bold mb-6 text-white drop-shadow-lg">
							EventStorming Facilitation Workshop
						</h1>
						<p class="text-2xl md:text-3xl mb-8 text-white/95 drop-shadow-md">
							Master the art of collaborative domain discovery
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Overview -->
		<Section>
			<div class="max-w-3xl mx-auto text-center">
				<p class="text-xl text-vg-gray-dark leading-relaxed">
					EventStorming is a collaborative workshop format for rapidly exploring complex business domains. This workshop teaches you how to facilitate your own sessions, from Big Picture exploration through Process Modeling to Software Design. You will leave ready to run EventStorming with your own teams, regardless of your role.
				</p>
			</div>
		</Section>

		<!-- Upcoming Dates -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-vg-burgundy">
				Upcoming Dates
			</h2>
			<div class="flex flex-wrap justify-center gap-6 max-w-3xl mx-auto">
				{eventstorming.instances.map((instance) => (
					<div class="bg-white rounded-xl shadow-lg border-t-4 border-vg-red p-5 flex-1 min-w-[280px] max-w-sm">
						<h3 class="text-xl font-bold text-vg-burgundy mb-3">{instance.dates}</h3>
						<div class="space-y-2 text-sm text-vg-gray-dark mb-4">
							<div class="flex items-center gap-2">
								<Icon name="laptop" size="sm" class="text-vg-red" />
								<span>{eventstorming.format} - {eventstorming.duration}</span>
							</div>
							<div class="flex items-center gap-2">
								<Icon name="refresh" size="sm" class="text-vg-red" />
								<span>{eventstorming.schedule}</span>
							</div>
							<div class="flex items-center gap-2">
								<Icon name="check" size="sm" class="text-vg-red" />
								<span>Limited to 25 participants</span>
							</div>
							<div class="flex items-center gap-2">
								<Icon name="check" size="sm" class="text-vg-red" />
								<span>Early bird: <strong class="text-vg-burgundy">{instance.earlyBirdPrice}</strong> <span class="text-sm text-vg-gray">(until {instance.earlyBirdDeadline})</span></span>
							</div>
							<div class="flex items-center gap-2">
								<Icon name="check" size="sm" class="text-vg-red" />
								<span>Regular: {instance.regularPrice}</span>
							</div>
							<div class="flex items-center gap-2">
								<Icon name="check" size="sm" class="text-vg-red" />
								<span>3-5 tickets: code <code class="bg-vg-gray-light px-1 py-0.5 rounded text-sm font-mono">Group_3</code> for $100 off</span>
							</div>
							<div class="flex items-center gap-2">
								<Icon name="check" size="sm" class="text-vg-red" />
								<span>6+ tickets: code <code class="bg-vg-gray-light px-1 py-0.5 rounded text-sm font-mono">Group_6</code> for $200 off</span>
							</div>
						</div>
						<Button
							href={registrationUrl(instance, 'workshop_detail')}
							variant="primary"
							class="w-full text-center"
							onclick={`if (window.posthog) { window.posthog.capture('workshop_registration_click', { 'workshop_name': '${eventstorming.title}', 'workshop_date': '${instance.dates}', 'link_location': 'workshop_detail_page', 'value': ${parseFloat(instance.earlyBirdPrice.replace(/[$,]/g, '').split(' ')[0])} }); } if (window.gtag) { gtag('event', 'workshop_registration_click', { 'workshop_name': '${eventstorming.title}', 'workshop_date': '${instance.dates}', 'link_location': 'workshop_detail_page', 'value': ${parseFloat(instance.earlyBirdPrice.replace(/[$,]/g, '').split(' ')[0])} }); }`}
						>
							Register <Icon name="arrow-right" size="sm" />
						</Button>
					</div>
				))}
			</div>
		</Section>

		<!-- What You Will Learn -->
		<Section>
			<h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-vg-burgundy">
				What You Will Learn
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				<div class="bg-white rounded-xl shadow-md p-8">
					<div class="flex items-center mb-4">
						<div class="bg-vg-red text-white text-xl font-bold rounded-full w-10 h-10 flex items-center justify-center mr-3 flex-shrink-0">
							1
						</div>
						<h3 class="text-xl font-bold text-vg-burgundy">Big Picture EventStorming</h3>
					</div>
					<ul class="space-y-3 text-vg-gray-dark">
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Map your end-to-end business processes in a single collaborative session</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Surface hidden bottlenecks, hot spots, and untested assumptions</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Build shared understanding between business and technical people</span>
						</li>
					</ul>
				</div>

				<div class="bg-white rounded-xl shadow-md p-8">
					<div class="flex items-center mb-4">
						<div class="bg-vg-red text-white text-xl font-bold rounded-full w-10 h-10 flex items-center justify-center mr-3 flex-shrink-0">
							2
						</div>
						<h3 class="text-xl font-bold text-vg-burgundy">Process Modeling</h3>
					</div>
					<ul class="space-y-3 text-vg-gray-dark">
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Drill into specific processes to uncover commands, actors, and policies</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Discover natural service boundaries and integration points</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Identify improvement opportunities in detailed workflows</span>
						</li>
					</ul>
				</div>

				<div class="bg-white rounded-xl shadow-md p-8">
					<div class="flex items-center mb-4">
						<div class="bg-vg-red text-white text-xl font-bold rounded-full w-10 h-10 flex items-center justify-center mr-3 flex-shrink-0">
							3
						</div>
						<h3 class="text-xl font-bold text-vg-burgundy">Software Design</h3>
					</div>
					<ul class="space-y-3 text-vg-gray-dark">
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Translate workshop discoveries into actionable software design</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Bridge the gap between domain exploration and solution architecture</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Identify aggregates, bounded contexts, and integration patterns from your model</span>
						</li>
					</ul>
				</div>

				<div class="bg-white rounded-xl shadow-md p-8">
					<div class="flex items-center mb-4">
						<div class="bg-vg-red text-white text-xl font-bold rounded-full w-10 h-10 flex items-center justify-center mr-3 flex-shrink-0">
							4
						</div>
						<h3 class="text-xl font-bold text-vg-burgundy">Running Your Own Workshop</h3>
					</div>
					<ul class="space-y-3 text-vg-gray-dark">
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Handle common facilitation challenges with proven techniques</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Plan your first EventStorming session for back at the office</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Leave with a preparation checklist, logistics plan, and participant selection guide</span>
						</li>
					</ul>
				</div>
			</div>
		</Section>

		<!-- Who Should Attend -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-vg-burgundy">
				Who Should Attend
			</h2>
			<div class="max-w-4xl mx-auto">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
					<ul class="space-y-3 text-vg-gray-dark">
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span><strong>Software developers</strong> who want to understand the domain before writing code</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span><strong>Architects</strong> looking for a lightweight approach to system-level discovery</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span><strong>Product managers</strong> who want to align teams around shared domain understanding</span>
						</li>
					</ul>
					<ul class="space-y-3 text-vg-gray-dark">
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span><strong>Business analysts</strong> who want richer domain conversations than requirements documents allow</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span><strong>Scrum Masters and team leads</strong> looking for facilitation techniques that produce real insights</span>
						</li>
					</ul>
				</div>
				<p class="text-center text-vg-gray-dark text-lg">
					No prior EventStorming experience needed.
				</p>
			</div>
		</Section>

		<!-- Workshop Format -->
		<Section>
			<h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-vg-burgundy">
				Workshop Format
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
				<div class="bg-white rounded-xl shadow-md p-8">
					<div class="flex items-start gap-3 mb-4">
						<Icon name="laptop" size="lg" class="text-vg-red flex-shrink-0 mt-1" />
						<div>
							<h3 class="text-lg font-bold text-vg-burgundy">Virtual Delivery</h3>
							<p class="text-vg-gray-dark">4 sessions x 3 hours each over 4 days</p>
						</div>
					</div>
				</div>
				<div class="bg-white rounded-xl shadow-md p-8">
					<div class="flex items-start gap-3 mb-4">
						<Icon name="refresh" size="lg" class="text-vg-red flex-shrink-0 mt-1" />
						<div>
							<h3 class="text-lg font-bold text-vg-burgundy">Interactive Format</h3>
							<p class="text-vg-gray-dark">Small cohort, camera-on participatory format with collaborative exercises</p>
						</div>
					</div>
				</div>
				<div class="bg-white rounded-xl shadow-md p-8">
					<div class="flex items-start gap-3 mb-4">
						<Icon name="office" size="lg" class="text-vg-red flex-shrink-0 mt-1" />
						<div>
							<h3 class="text-lg font-bold text-vg-burgundy">Tools</h3>
							<p class="text-vg-gray-dark">Zoom for video conferencing and Miro for collaborative exercises. All software is free to use.</p>
						</div>
					</div>
				</div>
				<div class="bg-white rounded-xl shadow-md p-8">
					<div class="flex items-start gap-3 mb-4">
						<Icon name="check" size="lg" class="text-vg-red flex-shrink-0 mt-1" />
						<div>
							<h3 class="text-lg font-bold text-vg-burgundy">Certificate</h3>
							<p class="text-vg-gray-dark">Certificate of completion included for all participants who attend the full workshop.</p>
						</div>
					</div>
				</div>
			</div>
		</Section>

		<!-- Testimonials -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-vg-burgundy">
				What Participants Say
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
				<TestimonialCard
					quote="I felt I learnt and refined understanding on event storming as a process, what it can do. And the training emphasized the need for me to continue to embrace chaos. I felt as a facilitator, Paul was kind and non-judgmental, and I liked observing the little things he did in the process."
					role="Workshop Participant"
					industry="Public Workshop"
					rating={10}
					workshop="EventStorming Facilitation"
				/>
				<TestimonialCard
					quote="Paul has done a great job of making a 4 day training something I looked forward to daily. Not only was the content great to understand, but the exercises reinformed learning and had great opportunity to have discussions."
					role="Workshop Participant"
					industry="Financial Services"
					rating={10}
					workshop="EventStorming Facilitation"
				/>
				<TestimonialCard
					quote="I gained much clarity on some fuzzy topics, and reinforced some ideas/knowledge I already had about ES. Most importantly I learned how ES can be taught/delivered in an approachable/iterative way."
					role="Workshop Participant"
					industry="Public Workshop"
					rating={10}
					workshop="EventStorming Facilitation"
				/>
			</div>
			<div class="text-center mt-8">
				<a href="/testimonials" class="inline-flex items-center gap-1 text-vg-red hover:text-vg-red-light font-semibold text-lg">
					View All Testimonials
					<Icon name="arrow-right" size="sm" />
				</a>
			</div>
		</Section>

		<!-- Your Instructor -->
		<Section>
			<h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-vg-burgundy">
				Your Instructor
			</h2>
			<div class="flex flex-col md:flex-row items-center gap-8 max-w-4xl mx-auto">
				<div class="flex-shrink-0">
					<img
						src="/images/paul-portrait.webp"
						alt="Paul Rayner"
						class="w-36 h-36 rounded-full object-cover shadow-lg"
						loading="lazy"
					/>
				</div>
				<div>
					<h3 class="text-2xl font-bold text-vg-burgundy mb-1">Paul Rayner</h3>
					<p class="text-vg-red font-semibold mb-4">Software Design Consultant & EventStorming Facilitator</p>
					<p class="text-vg-gray-dark mb-4">
						35+ years in software development. Creator of Explore DDD conference. Trained 580+ workshop participants with a 9.2/10 average rating. Certified EventStorming facilitator trained by Alberto Brandolini, the creator of EventStorming.
					</p>
					<a href="/about" class="inline-flex items-center gap-1 text-vg-red hover:text-vg-red-light font-semibold">
						Full Bio <Icon name="arrow-right" size="sm" />
					</a>
				</div>
			</div>
		</Section>

		<!-- FAQ -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-vg-burgundy">
				Frequently Asked Questions
			</h2>
			<div class="max-w-3xl mx-auto space-y-8">
				<div>
					<h3 class="text-xl font-bold text-vg-burgundy mb-3">
						What if I have no EventStorming experience?
					</h3>
					<p class="text-vg-gray-dark">
						No experience needed. The workshop teaches EventStorming from the fundamentals, building up progressively across the four sessions. You will learn by doing, with plenty of guided practice along the way.
					</p>
				</div>

				<div>
					<h3 class="text-xl font-bold text-vg-burgundy mb-3">
						Will I be able to facilitate sessions after this workshop?
					</h3>
					<p class="text-vg-gray-dark">
						Yes. The workshop builds facilitation skills progressively across all four sessions, combining instruction with hands-on practice. You will leave with the skills and confidence to facilitate sessions with your own teams.
					</p>
				</div>

				<div>
					<h3 class="text-xl font-bold text-vg-burgundy mb-3">
						How is this different from a private EventStorming workshop?
					</h3>
					<p class="text-vg-gray-dark">
						Public workshops teach you the EventStorming facilitation method so you can run sessions yourself. Private workshops apply EventStorming directly to your specific domain and business challenges. If you want to learn the skill, take the public workshop. If you want to solve a specific problem, <a href="/services/eventstorming" class="text-vg-red hover:underline">book a private workshop</a>.
					</p>
				</div>

				<div>
					<h3 class="text-xl font-bold text-vg-burgundy mb-3">
						What materials do I receive?
					</h3>
					<p class="text-vg-gray-dark">
						All participants receive a certificate of completion, Miro templates for running your own sessions, a facilitation guide, and reference materials you can use when facilitating EventStorming with your teams.
					</p>
				</div>

				<div>
					<h3 class="text-xl font-bold text-vg-burgundy mb-3">
						Do you offer team discounts?
					</h3>
					<p class="text-vg-gray-dark">
						Yes! Use these discount codes when registering:
					</p>
					<ul class="mt-2 space-y-1 text-vg-gray-dark">
						<li><strong>3-5 tickets:</strong> use code <code class="bg-vg-gray-light px-1.5 py-0.5 rounded text-sm font-mono">Group_3</code> for $100 off per ticket</li>
						<li><strong>6+ tickets:</strong> use code <code class="bg-vg-gray-light px-1.5 py-0.5 rounded text-sm font-mono">Group_6</code> for $200 off per ticket</li>
					</ul>
					<p class="mt-2 text-vg-gray-dark">
						For groups of 10+, consider a <a href="/services/eventstorming" class="text-vg-red hover:underline">private workshop</a> customized to your specific domain.
					</p>
				</div>
			</div>
		</Section>

		<!-- Final CTA -->
		<Section background="burgundy">
			<div class="text-center max-w-3xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-bold mb-6">
					Ready to Master EventStorming?
				</h2>
				<p class="text-xl mb-8 text-vg-gray-light">
					Join the next cohort and learn to facilitate collaborative domain discovery workshops with confidence.
				</p>
				{eventstorming.instances.length > 0 && (
					<Button
						href={registrationUrl(eventstorming.instances[0], 'workshop_detail')}
						variant="outlined"
						onclick={`if (window.posthog) { window.posthog.capture('workshop_registration_click', { 'workshop_name': '${eventstorming.title}', 'workshop_date': '${eventstorming.instances[0].dates}', 'link_location': 'workshop_detail_page_cta', 'value': ${parseFloat(eventstorming.instances[0].earlyBirdPrice.replace(/[$,]/g, '').split(' ')[0])} }); } if (window.gtag) { gtag('event', 'workshop_registration_click', { 'workshop_name': '${eventstorming.title}', 'workshop_date': '${eventstorming.instances[0].dates}', 'link_location': 'workshop_detail_page_cta', 'value': ${parseFloat(eventstorming.instances[0].earlyBirdPrice.replace(/[$,]/g, '').split(' ')[0])} }); }`}
					>
						Register Now <Icon name="arrow-right" size="sm" />
					</Button>
				)}
			</div>
		</Section>

		<BackToTop />
		<Footer />
	</body>
</html>
