---
import BaseHead from '../../components/BaseHead.astro';
import Button from '../../components/Button.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import Section from '../../components/Section.astro';
import ServiceCard from '../../components/ServiceCard.astro';

const title = 'Services - Virtual Genius';
const description = 'Embedded team engagements, EventStorming workshops, DDD training, and coaching. Design skills meet agentic development to help your team build better software.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="bg-white">
		<Header />

		<!-- Hero with Workshop Background -->
		<section class="relative w-full overflow-hidden" style="height: 360px;">
			<!-- Background Image -->
			<div class="absolute inset-0 w-full h-full">
				<img
					src="/images/eddd-workshop.webp"
					alt="Workshop collaboration"
					class="w-full h-full object-cover"
					style="filter: brightness(0.6); object-position: center 40%;"
				/>
				<!-- Dark overlay for text readability -->
				<div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/30 to-black/50"></div>
			</div>

			<!-- Content Overlay -->
			<div class="relative z-10 flex items-center justify-center h-full">
				<div class="max-w-screen-xl mx-auto px-6 w-full">
					<div class="text-center max-w-4xl mx-auto">
						<h1 class="text-5xl md:text-7xl font-bold mb-6 text-white drop-shadow-lg">
							Services
						</h1>
						<p class="text-2xl md:text-3xl mb-8 text-white/95 drop-shadow-md">
							Expert guidance in EventStorming, Domain-Driven Design, and collaborative software modeling
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Service Overview Cards -->
		<Section>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				<ServiceCard
					title="Embedded Team Engagements"
					description="A senior design practitioner joins your team part-time, pairing deep design skills with agentic development on your code from day one"
					href="/services/embedded"
					linkText="Learn More"
				/>
				<ServiceCard
					title="EventStorming Services"
					description="Facilitated workshops on your domain, or a program that trains a cohort inside your team to become facilitators themselves"
					href="/services/eventstorming"
					linkText="Learn More"
				/>
				<ServiceCard
					title="DDD Training"
					description="Essential and Strategic Domain-Driven Design courses for developers, architects, and product teams"
					href="/services/training"
					linkText="View Courses"
				/>
				<ServiceCard
					title="Coaching & Consulting"
					description="Ongoing support for pilot projects, code reviews, design walkthroughs, and implementation guidance"
					href="/services/coaching"
					linkText="Get Started"
				/>
			</div>
		</Section>

		<!-- Embedded Team Engagements Details -->
		<Section background="gray">
			<div class="max-w-5xl mx-auto">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div class="order-2 lg:order-1">
						<img
							src="/images/bti360-discussion-group.webp"
							alt="Team discussion and collaborative design session"
							class="w-full aspect-video object-cover rounded-lg shadow-lg"
						/>
					</div>
					<div class="order-1 lg:order-2">
						<h2 class="text-3xl md:text-4xl font-bold mb-6 text-vg-burgundy">Embedded Team Engagements</h2>
						<p class="text-lg text-vg-gray-dark mb-6">
							Deep design skills meet agentic development. Paul joins your team part-time, working on real features using tools like Claude Code, developing the practices that make agentic development actually work. Knowledge transfer happens through doing the work together.
						</p>
						<ul class="space-y-3 text-vg-gray-dark mb-6">
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-1 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>3-6 month engagements at 20-30 hours per week</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-1 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Pair programming, design reviews, and agentic AI workflows</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-1 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Team grows stronger and more self-sufficient</span>
							</li>
						</ul>
						<a
							href="/services/embedded"
							class="inline-flex items-center gap-1 text-vg-red hover:text-vg-red-light font-semibold text-lg"
						>
							Learn About Embedded Engagements
							<Icon name="chevron-right" size="md" />
						</a>
					</div>
				</div>
			</div>
		</Section>

		<!-- EventStorming Details -->
		<Section>
			<div class="max-w-5xl mx-auto">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div class="order-2 lg:order-1">
						<div class="aspect-[16/15] rounded-lg shadow-lg overflow-hidden">
							<video
								class="w-[111%] h-full object-cover -ml-[11%]"
								controls
								autoplay
								loop
								muted
								playsinline
								aria-label="Timelapse of EventStorming workshop participants collaborating on domain modeling using sticky notes"
							>
								<source src="/videos/eventstorming-timelapse.mp4" type="video/mp4" />
								Your browser does not support the video tag.
							</video>
						</div>
					</div>
					<div class="order-1 lg:order-2">
						<h2 class="text-3xl md:text-4xl font-bold mb-6 text-vg-burgundy">EventStorming Services</h2>
						<p class="text-lg text-vg-gray-dark mb-6">
							Rapid, collaborative workshops that bring business and technical teams together to explore complex domains. Two engagement shapes, depending on the outcome you want.
						</p>
						<div class="space-y-4 mb-6">
							<div class="border-l-4 border-vg-red pl-4">
								<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">Facilitated Workshops</h3>
								<p class="text-vg-gray-dark">
									Paul facilitates on your domain. Your team walks away with shared understanding, identified pain points, and a prioritized roadmap.
								</p>
							</div>
							<div class="border-l-4 border-vg-red pl-4">
								<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">Facilitator Program</h3>
								<p class="text-vg-gray-dark">
									Train a cohort to become facilitators themselves. Paul trains, co-facilitates on real work, then fades back as your team runs it independently.
								</p>
							</div>
						</div>
						<a
							href="/services/eventstorming"
							class="inline-flex items-center gap-1 text-vg-red hover:text-vg-red-light font-semibold text-lg"
						>
							Compare the Two Options
							<Icon name="chevron-right" size="md" />
						</a>
					</div>
				</div>
			</div>
		</Section>

		<!-- DDD Training Details -->
		<Section background="gray">
			<div class="max-w-5xl mx-auto">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div>
						<h2 class="text-3xl md:text-4xl font-bold mb-6 text-vg-burgundy">DDD Training</h2>
						<p class="text-lg text-vg-gray-dark mb-6">
							Comprehensive training programs teaching Domain-Driven Design patterns and practices for building maintainable, business-aligned software.
						</p>
						<div class="space-y-4 mb-6">
							<div class="border-l-4 border-vg-red pl-4">
								<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">Essential DDD</h3>
								<p class="text-vg-gray-dark">
									Foundational patterns: domain modeling, collaborative modeling with EventStorming, tactical building blocks, and bounded contexts
								</p>
							</div>
							<div class="border-l-4 border-vg-red pl-4">
								<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">Strategic DDD</h3>
								<p class="text-vg-gray-dark">
									Advanced techniques: context mapping, core domain identification, and large-scale structure
								</p>
							</div>
						</div>
						<ul class="space-y-3 text-vg-gray-dark mb-6">
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-1 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>2-3 day courses (customizable)</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-1 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>In-person, remote, or hybrid delivery</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-1 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Hands-on exercises and real-world examples</span>
							</li>
						</ul>
						<a
							href="/services/training"
							class="inline-flex items-center gap-1 text-vg-red hover:text-vg-red-light font-semibold text-lg"
						>
							Explore Training Options
							<Icon name="chevron-right" size="md" />
						</a>
					</div>
					<div>
						<img
							src="/images/paul-teaching.webp"
							alt="Paul Rayner teaching Domain-Driven Design"
							class="w-full aspect-video object-cover rounded-lg shadow-lg"
						/>
					</div>
				</div>
			</div>
		</Section>

		<!-- Coaching Details -->
		<Section>
			<div class="max-w-5xl mx-auto">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div class="order-2 lg:order-1">
						<img
							src="/images/workshop-collaboration.webp"
							alt="Team members collaborating during a workshop session"
							class="w-full aspect-video object-cover rounded-lg shadow-lg"
						/>
					</div>
					<div class="order-1 lg:order-2">
						<h2 class="text-3xl md:text-4xl font-bold mb-6 text-vg-burgundy">Coaching & Consulting</h2>
						<p class="text-lg text-vg-gray-dark mb-6">
							Workshops and training build shared understanding. Coaching helps the team apply it. The most effective engagements combine both: a facilitated EventStorming or DDD training followed by ongoing coaching as the team puts those practices to work on real features.
						</p>
						<div class="grid grid-cols-1 gap-4 mb-6">
							<div class="bg-white p-4 rounded-lg shadow">
								<h3 class="font-semibold text-vg-burgundy mb-1">Post-Workshop Coaching</h3>
								<p class="text-sm text-vg-gray-dark">8-15 hours of follow-up support after workshops</p>
							</div>
							<div class="bg-white p-4 rounded-lg shadow">
								<h3 class="font-semibold text-vg-burgundy mb-1">Pilot Project Support</h3>
								<p class="text-sm text-vg-gray-dark">Embedded coaching (6-week tiger teams)</p>
							</div>
							<div class="bg-white p-4 rounded-lg shadow">
								<h3 class="font-semibold text-vg-burgundy mb-1">Code Reviews & Design Walkthroughs</h3>
								<p class="text-sm text-vg-gray-dark">Architectural feedback and DDD guidance</p>
							</div>
							<div class="bg-white p-4 rounded-lg shadow">
								<h3 class="font-semibold text-vg-burgundy mb-1">Monthly Retainers</h3>
								<p class="text-sm text-vg-gray-dark">Ongoing access for continuous guidance</p>
							</div>
						</div>
						<a
							href="/services/coaching"
							class="inline-flex items-center gap-1 text-vg-red hover:text-vg-red-light font-semibold text-lg"
						>
							Learn About Coaching Options
							<Icon name="chevron-right" size="md" />
						</a>
					</div>
				</div>
			</div>
		</Section>


		<!-- How to Get Started -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold mb-8 text-center text-vg-burgundy">
				How to Get Started
			</h2>
			<div class="max-w-4xl mx-auto">
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
					<div class="text-center">
						<div class="bg-vg-red text-white text-2xl font-bold rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
							1
						</div>
						<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">Get in Touch</h3>
						<p class="text-vg-gray-dark">
							Email us to discuss your challenges and goals
						</p>
					</div>
					<div class="text-center">
						<div class="bg-vg-red text-white text-2xl font-bold rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
							2
						</div>
						<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">Planning Call</h3>
						<p class="text-vg-gray-dark">
							We'll customize an approach for your specific needs
						</p>
					</div>
					<div class="text-center">
						<div class="bg-vg-red text-white text-2xl font-bold rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
							3
						</div>
						<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">Start Working Together</h3>
						<p class="text-vg-gray-dark">
							Workshop, training, coaching, or embedded engagement begins
						</p>
					</div>
				</div>

				<div class="text-center">
					<p class="text-xl text-vg-gray-dark mb-6">
						All services are customized to your team's specific context and experience level
					</p>
					<Button href="/contact" variant="primary" class="px-8 py-4">
						Contact Us
					</Button>
				</div>
			</div>
		</Section>

		<Footer />
	</body>
</html>
