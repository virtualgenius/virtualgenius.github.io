---
import BackToTop from '../../components/BackToTop.astro';
import BaseHead from '../../components/BaseHead.astro';
import Button from '../../components/Button.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import Section from '../../components/Section.astro';

const title = 'Embedded Team Engagements - Virtual Genius';
const description = 'A senior design practitioner who joins your team to teach agentic development from inside the codebase. Pair programming, design reviews, and mentoring through real work on real features.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="bg-white">
		<Header />

		<!-- Hero with Collaboration Background -->
		<section class="relative w-full overflow-hidden" style="height: 360px;">
			<!-- Background Image -->
			<div class="absolute inset-0 w-full h-full">
				<img
					src="/images/bti360-paul-team-whiteboard.webp"
					alt="Paul working through a domain model with a small team at a whiteboard"
					class="w-full h-full object-cover"
					style="filter: brightness(0.6); object-position: center 30%;"
				/>
				<!-- Dark overlay for text readability -->
				<div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/30 to-black/50"></div>
			</div>

			<!-- Content Overlay -->
			<div class="relative z-10 flex items-center justify-center h-full">
				<div class="max-w-screen-xl mx-auto px-6 w-full">
					<div class="text-center max-w-4xl mx-auto">
						<h1 class="text-5xl md:text-7xl font-bold mb-6 text-white drop-shadow-lg">
							Embedded Team Engagements
						</h1>
						<p class="text-2xl md:text-3xl mb-8 text-white/95 drop-shadow-md">
							A senior design practitioner embedded in your team, teaching agentic development from inside the codebase
						</p>
						<Button href="/contact" variant="primary">
							Schedule a Conversation
						</Button>
					</div>
				</div>
			</div>
		</section>

		<!-- Core Proposition -->
		<Section>
			<div class="max-w-5xl mx-auto">
				<!-- Text + Image side by side, image stretches to match text height -->
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-stretch">
					<div class="flex flex-col justify-center">
						<h2 class="text-3xl md:text-4xl font-bold mb-4 text-vg-burgundy">Not a Consultant. A Teammate.</h2>
						<p class="text-xl font-semibold text-vg-red mb-6">
							Deep design skills meet agentic development, working on your code from day one.
						</p>
						<p class="text-lg text-vg-gray-dark mb-4">
							AI doesn't replace your team's judgment; it amplifies whatever practices already exist. Strong design discipline plus AI produces remarkable results. Weak practices plus AI produces technical debt at unprecedented speed.<a id="fn1-ref" href="#fn1" style="scroll-margin-top: 6rem;" class="text-vg-red no-underline align-super text-xs font-semibold">1</a> Paul joins your team part-time, working on real features using tools like Claude Code, developing the practices that make agentic development actually work.
						</p>
						<p class="text-lg text-vg-gray-dark mb-4">
							Most consultants advise from the outside. In an embedded engagement, Paul works on real features and real deadlines alongside your developers. The knowledge transfer happens through doing the work together, not through slide decks or recommendations documents.
						</p>
						<div class="bg-vg-red/5 border border-vg-red/20 rounded-lg p-4">
							<p class="font-semibold text-vg-burgundy mb-1">The metric that matters: Shortest Time to Customer Value.</p>
							<p class="text-vg-gray-dark text-sm mb-0">Not lines of code. Not velocity points. Not hours estimated vs. hours spent. The goal is compressing the time from "we have an idea" to "a customer is using it and we can see that it's working." Every practice in the engagement, from TDD to observability to domain modeling, serves that outcome.</p>
						</div>
					</div>
					<div class="min-h-[300px]">
						<img
							src="/images/bti360-paul-listening-with-team.webp"
							alt="Paul sitting alongside team members during a working session"
							class="w-full h-full object-cover rounded-lg shadow-lg"
						/>
					</div>
				</div>

				<!-- Logistics strip, full width below -->
				<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-10 pt-8 border-t border-gray-200">
					<div>
						<p class="text-sm font-semibold text-vg-burgundy uppercase tracking-wide mb-1">Duration</p>
						<p class="text-vg-gray-dark">3-6 months (starting with a 1-month pilot)</p>
					</div>
					<div>
						<p class="text-sm font-semibold text-vg-burgundy uppercase tracking-wide mb-1">Commitment</p>
						<p class="text-vg-gray-dark">20-30 hrs/week</p>
					</div>
					<div>
						<p class="text-sm font-semibold text-vg-burgundy uppercase tracking-wide mb-1">Availability</p>
						<p class="text-vg-gray-dark">One team at a time</p>
					</div>
					<div>
						<p class="text-sm font-semibold text-vg-burgundy uppercase tracking-wide mb-1">Format</p>
						<p class="text-vg-gray-dark">In-person (Denver) or remote</p>
					</div>
				</div>
			</div>
		</Section>

		<!-- What Agentic Development Actually Means -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold mb-4 text-center text-vg-burgundy">
				What Agentic Development Actually Means
			</h2>
			<p class="text-lg text-vg-gray-dark text-center max-w-3xl mx-auto mb-12">
				Not vibe coding. Not automation without oversight. A disciplined practice where AI amplifies experienced human judgment.
			</p>
			<div class="max-w-5xl mx-auto">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					<!-- What It Is -->
					<div class="bg-white p-8 rounded-lg border-2 border-vg-red shadow-lg">
						<h3 class="text-2xl font-semibold mb-6 text-vg-red">What It Is</h3>
						<ul class="space-y-4 text-vg-gray-dark">
							<li class="flex items-start gap-3">
								<span class="text-vg-red mt-1 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>AI coding tools (Claude Code, Cursor, Codex) generating code under human direction and review</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-vg-red mt-1 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Test-driven workflows: specify behavior first, let AI implement, verify rigorously</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-vg-red mt-1 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Developers shifting from writing every line to specifying, reviewing, and approving with higher-level design judgment</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-vg-red mt-1 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Focused on delivery from day one. Each feature delivered crystallizes another piece of the repeatable pipeline. The tooling and process emerge from building real features, not from building a platform first and hoping features follow.</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-vg-red mt-1 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Tooling-agnostic: the specific AI tool is a commodity choice. The practices are what matter.</span>
							</li>
						</ul>
					</div>
					<!-- What It Isn't -->
					<div class="bg-gray-100 p-8 rounded-lg">
						<h3 class="text-2xl font-semibold mb-6 text-vg-gray-dark">What It Isn't</h3>
						<ul class="space-y-4 text-vg-gray-dark">
							<li class="flex items-start gap-3">
								<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></span>
								<span>Autonomous agents running overnight generating unsupervised code</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></span>
								<span>"Vibe coding" where nobody looks at what the AI produces</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></span>
								<span>Months of "building the pipeline" before delivering anything. The pipeline emerges from the delivery.</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></span>
								<span>A tool installation or platform that runs itself once set up</span>
							</li>
							<li class="flex items-start gap-3">
								<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></span>
								<span>A short assessment that ends with a recommendations document</span>
							</li>
						</ul>
					</div>
				</div>
				<p class="text-center text-vg-gray-dark mt-8 max-w-3xl mx-auto">
					The rigor doesn't go away when AI writes the code. It moves up a level of abstraction, to discovery, design, specification, and review. That's where the real leverage is.
				</p>
			</div>
		</Section>

		<!-- What to Expect -->
		<Section>
			<h2 class="text-3xl md:text-4xl font-bold mb-4 text-center text-vg-burgundy">
				What to Expect
			</h2>
			<p class="text-lg text-vg-gray-dark text-center max-w-3xl mx-auto mb-12">
				Agentic development delivers real productivity gains, but the size of the gain depends on your starting point. Here's an honest picture.
			</p>

			<div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
				<!-- New Code -->
				<div class="bg-vg-gray-light p-8 rounded-lg shadow-lg border-l-4 border-vg-red">
					<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">New Features & Greenfield Code</h3>
					<p class="text-3xl font-bold text-vg-red mb-3">Order-of-magnitude gains</p>
					<p class="text-vg-gray-dark mb-4">
						When building new, well-scoped features with clear specifications and good test coverage, agentic development compresses weeks of work into days. The AI thrives on consistent patterns, clear guidelines, and well-defined APIs.
					</p>
					<p class="text-vg-gray-dark text-sm">
						This is where the engagement typically starts: a pilot project on new work where the team can experience the full potential of the approach.
					</p>
				</div>

				<!-- Legacy Code -->
				<div class="bg-vg-gray-light p-8 rounded-lg shadow-lg border-l-4 border-vg-gray">
					<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">Heritage Systems & Legacy Code</h3>
					<p class="text-3xl font-bold text-vg-gray-dark mb-3">Strategic, targeted gains</p>
					<p class="text-vg-gray-dark mb-4">
						Codebases with 10 or 20 years of accumulated design decisions are harder for humans and AI alike. Gains come from wrapping existing capabilities in APIs, building test harnesses that make change safe, and strategically choosing where to modernize.
					</p>
					<p class="text-vg-gray-dark text-sm">
						The embedded engagement helps identify where AI-assisted development will have the highest leverage in your existing systems, and where it won't.
					</p>
				</div>
			</div>

			<!-- DORA callout -->
			<div class="max-w-4xl mx-auto mt-10 bg-vg-gray-light border border-gray-200 rounded-lg p-6">
				<div class="flex items-start gap-4">
					<div class="flex-shrink-0 w-10 h-10 bg-vg-red/10 rounded-full flex items-center justify-center mt-1">
						<svg class="w-5 h-5 text-vg-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
					</div>
					<div>
						<p class="text-vg-gray-dark font-semibold mb-1">Why this matters</p>
						<p class="text-vg-gray-dark">
							Google's DORA research found that most teams adopting AI-assisted development actually experience <em>increased delivery unpredictability</em>, despite feeling faster.<a href="#fn1" class="text-vg-red no-underline align-super text-xs font-semibold">1</a> Accelerating the wrong part of a system makes the whole thing slower. The embedded engagement focuses on identifying and accelerating the right constraints first.
						</p>
					</div>
				</div>
			</div>
		</Section>

		<!-- How You'll Know It's Working -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold mb-4 text-center text-vg-burgundy">
				How You'll Know It's Working
			</h2>
			<p class="text-lg text-vg-gray-dark text-center max-w-3xl mx-auto mb-12">
				You won't have to wait months to find out. The engagement is designed to produce visible results quickly, so you can make informed decisions about continuing.
			</p>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
				<div class="bg-white p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">First Week</h3>
					<p class="text-2xl font-bold text-vg-red mb-3">"Check this out"</p>
					<p class="text-vg-gray-dark mb-4">
						The goal is something to show stakeholders early. Not a plan, not a deck, not an estimate. Something tangible you can point at and react to together.
					</p>
					<p class="text-vg-gray-dark text-sm">
						If the approach doesn't produce visible results quickly on your codebase with your team, you'll know immediately.
					</p>
				</div>
				<div class="bg-white p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">First Month</h3>
					<p class="text-2xl font-bold text-vg-red mb-3">Pipeline clarity</p>
					<p class="text-vg-gray-dark mb-4">
						Cycle time from idea to deployed feature. Defect rates. Throughput. These pipeline metrics tell you whether the team is actually moving faster with higher quality, or just feeling faster.
					</p>
					<p class="text-vg-gray-dark text-sm">
						The DORA research<a href="#fn1" class="text-vg-red no-underline align-super text-xs font-semibold">1</a> shows most teams feel faster but deliver less predictably. We measure so you don't have to guess.
					</p>
				</div>
				<div class="bg-white p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">Ongoing</h3>
					<p class="text-2xl font-bold text-vg-red mb-3">Customer signal</p>
					<p class="text-vg-gray-dark mb-4">
						Usage analytics, value validation, production observability. Building features that nobody uses is still waste, just faster waste. The engagement includes setting up the feedback loops to verify what's landing with customers.
					</p>
					<p class="text-vg-gray-dark text-sm">
						Most teams have pipeline metrics but no customer observability. Both matter.
					</p>
				</div>
			</div>

			<!-- Two Kinds of ROI -->
			<div class="max-w-5xl mx-auto mt-12">
				<h3 class="text-2xl font-bold mb-6 text-center text-vg-burgundy">Two Kinds of ROI</h3>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					<div class="bg-white p-8 rounded-lg shadow-lg border-l-4 border-vg-red">
						<p class="font-bold text-vg-burgundy mb-2">Direct: Time and cost compression</p>
						<p class="text-vg-gray-dark">The time and cost to build new capabilities compresses significantly. How much depends on the work, the team, and the starting point, but the difference is measurable and visible early. This is the number your finance team will care about.</p>
					</div>
					<div class="bg-white p-8 rounded-lg shadow-lg border-l-4 border-vg-burgundy">
						<p class="font-bold text-vg-burgundy mb-2">Indirect: Confidence and momentum</p>
						<p class="text-vg-gray-dark">Faster, higher-quality delivery changes what your team is willing to take on. Projects that seemed too risky or too expensive get reconsidered. Teams that were hesitant about new approaches gain confidence from seeing real results. This kind of ROI is harder to measure but often matters more.</p>
					</div>
				</div>
			</div>

			<!-- By 90 Days -->
			<div class="max-w-5xl mx-auto mt-10 bg-white border-2 border-vg-burgundy rounded-lg p-8">
				<h3 class="text-2xl font-bold mb-6 text-center text-vg-burgundy">By 90 Days</h3>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div class="flex items-start gap-3">
						<span class="text-vg-red mt-1 flex-shrink-0">
							<Icon name="check" size="sm" />
						</span>
						<span class="text-vg-gray-dark">Shipped features built with the new approach, with customer-facing observability proving they're being used</span>
					</div>
					<div class="flex items-start gap-3">
						<span class="text-vg-red mt-1 flex-shrink-0">
							<Icon name="check" size="sm" />
						</span>
						<span class="text-vg-gray-dark">A repeatable discovery-to-delivery pipeline the team can run without Paul</span>
					</div>
					<div class="flex items-start gap-3">
						<span class="text-vg-red mt-1 flex-shrink-0">
							<Icon name="check" size="sm" />
						</span>
						<span class="text-vg-gray-dark">Team members actively using agentic development with TDD in their daily work</span>
					</div>
					<div class="flex items-start gap-3">
						<span class="text-vg-red mt-1 flex-shrink-0">
							<Icon name="check" size="sm" />
						</span>
						<span class="text-vg-gray-dark">Measurable evidence of what's working: pipeline metrics, customer signal, and a clear picture of what to tackle next</span>
					</div>
				</div>
			</div>

			<!-- Why start with one month -->
			<div class="max-w-4xl mx-auto mt-10 bg-white border border-gray-200 rounded-lg p-6">
				<div class="flex items-start gap-4">
					<div class="flex-shrink-0 w-10 h-10 bg-vg-red/10 rounded-full flex items-center justify-center mt-1">
						<svg class="w-5 h-5 text-vg-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
					</div>
					<div>
						<p class="text-vg-gray-dark font-semibold mb-1">Why start with one month</p>
						<p class="text-vg-gray-dark">
							A month is enough time to prove the model works on your codebase, with your team, on real work. If the results are there, extending to a multi-month engagement is straightforward. If they're not, you've learned something valuable at a bounded cost. The results from the first month inform what comes next.
						</p>
					</div>
				</div>
			</div>
		</Section>

		<!-- Day-to-Day -->
		<Section>
			<h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-vg-burgundy">
				What the Day-to-Day Looks Like
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				<div class="bg-vg-gray-light p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-2xl font-semibold mb-4 text-vg-burgundy">Pair & Mob Programming</h3>
					<p class="text-vg-gray-dark">
						Working side-by-side with your developers on production code, using agentic AI tools as part of the workflow. Building the design and testing habits that make AI-generated code trustworthy.
					</p>
				</div>
				<div class="bg-vg-gray-light p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-2xl font-semibold mb-4 text-vg-burgundy">Design Reviews</h3>
					<p class="text-vg-gray-dark">
						Reviewing architecture decisions, domain models, and bounded context boundaries as part of the team's regular workflow. Catching design issues early, when they're cheap to fix.
					</p>
				</div>
				<div class="bg-vg-gray-light p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-2xl font-semibold mb-4 text-vg-burgundy">Mentoring & Skill Transfer</h3>
					<p class="text-vg-gray-dark">
						Building your team's capabilities in DDD, EventStorming, and software design. The goal is for the team to be self-sufficient after the engagement ends.
					</p>
				</div>
				<div class="bg-vg-gray-light p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-2xl font-semibold mb-4 text-vg-burgundy">EventStorming as Needed</h3>
					<p class="text-vg-gray-dark">
						Running focused EventStorming sessions when the team encounters a new subdomain or needs to rethink an existing model. Lightweight, just-in-time exploration.
					</p>
				</div>
			</div>
		</Section>

		<!-- Embedded vs. Advisory -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-vg-burgundy">
				Embedded vs. Traditional Consulting
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				<!-- Traditional -->
				<div class="bg-gray-100 p-8 rounded-lg md:order-1 order-2">
					<h3 class="text-2xl font-semibold mb-6 text-vg-gray-dark">Traditional Advisory</h3>
					<ul class="space-y-4 text-vg-gray-dark">
						<li class="flex items-start gap-3">
							<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M5 12h14"/></svg></span>
							<span>Observes from the outside</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M5 12h14"/></svg></span>
							<span>Delivers recommendations</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M5 12h14"/></svg></span>
							<span>Knowledge transfer through documents</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M5 12h14"/></svg></span>
							<span>Short engagements, limited context</span>
						</li>
						<li class="flex items-start gap-3">
