---
import BackToTop from '../../components/BackToTop.astro';
import BaseHead from '../../components/BaseHead.astro';
import Button from '../../components/Button.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import Section from '../../components/Section.astro';

const title = 'Embedded Team Engagements - Virtual Genius';
const description = 'Part-time, hands-on engagements where Paul joins your team to work on real code, real features, and real deadlines. Pair programming, design reviews, and mentoring from inside the team.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="bg-white">
		<Header />

		<!-- Hero with Collaboration Background -->
		<section class="relative w-full overflow-hidden" style="height: 360px;">
			<!-- Background Image -->
			<div class="absolute inset-0 w-full h-full">
				<img
					src="/images/bti360-paul-team-whiteboard.webp"
					alt="Paul working through a domain model with a small team at a whiteboard"
					class="w-full h-full object-cover"
					style="filter: brightness(0.6); object-position: center 30%;"
				/>
				<!-- Dark overlay for text readability -->
				<div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/30 to-black/50"></div>
			</div>

			<!-- Content Overlay -->
			<div class="relative z-10 flex items-center justify-center h-full">
				<div class="max-w-screen-xl mx-auto px-6 w-full">
					<div class="text-center max-w-4xl mx-auto">
						<h1 class="text-5xl md:text-7xl font-bold mb-6 text-white drop-shadow-lg">
							Embedded Team Engagements
						</h1>
						<p class="text-2xl md:text-3xl mb-8 text-white/95 drop-shadow-md">
							A senior practitioner helping your team build better software with AI coding tools
						</p>
						<Button href="/contact" variant="primary">
							Discuss an Engagement
						</Button>
					</div>
				</div>
			</div>
		</section>

		<!-- Core Proposition -->
		<Section>
			<div class="max-w-5xl mx-auto">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div>
						<h2 class="text-3xl md:text-4xl font-bold mb-6 text-vg-burgundy">Not a Consultant. A Teammate.</h2>
						<p class="text-lg text-vg-gray-dark mb-4">
							Teams adopting AI coding tools need more than tips on prompting. The real gains come from pairing design skills with AI workflows. Paul joins your team part-time, working on real features using tools like Claude Code, developing the practices that make AI-augmented development actually work.
						</p>
						<p class="text-lg text-vg-gray-dark mb-4">
							Most consultants advise from the outside. In an embedded engagement, Paul works on real features and real deadlines alongside your developers. The knowledge transfer happens through doing the work together, not through slide decks or recommendations documents.
						</p>
						<p class="text-lg text-vg-gray-dark">
							Typical engagements run 3-6 months at 20-30 hours per week. Paul takes on one engagement at a time, so your team gets his full attention. In-person for teams in the Denver metro area, remote everywhere else.
						</p>
					</div>
					<div>
						<img
							src="/images/bti360-paul-listening-with-team.webp"
							alt="Paul sitting alongside team members during a working session"
							class="w-full aspect-video object-cover rounded-lg shadow-lg"
						/>
					</div>
				</div>
			</div>
		</Section>

		<!-- Day-to-Day -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-vg-burgundy">
				What the Day-to-Day Looks Like
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				<div class="bg-white p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-2xl font-semibold mb-4 text-vg-burgundy">Pair & Mob Programming</h3>
					<p class="text-vg-gray-dark">
						Working side-by-side with your developers on production code, with AI coding assistants as part of the workflow. Developing practical patterns for when AI helps and when it gets in the way, and building the design and testing habits that make AI-generated code trustworthy.
					</p>
				</div>
				<div class="bg-white p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-2xl font-semibold mb-4 text-vg-burgundy">Design Reviews</h3>
					<p class="text-vg-gray-dark">
						Reviewing architecture decisions, domain models, and bounded context boundaries as part of the team's regular workflow. Catching design issues early, when they're cheap to fix.
					</p>
				</div>
				<div class="bg-white p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-2xl font-semibold mb-4 text-vg-burgundy">Mentoring & Skill Transfer</h3>
					<p class="text-vg-gray-dark">
						Building your team's capabilities in DDD, EventStorming, and software design. The goal is for the team to be self-sufficient after the engagement ends.
					</p>
				</div>
				<div class="bg-white p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-2xl font-semibold mb-4 text-vg-burgundy">EventStorming as Needed</h3>
					<p class="text-vg-gray-dark">
						Running focused EventStorming sessions when the team encounters a new subdomain or needs to rethink an existing model. Lightweight, just-in-time exploration.
					</p>
				</div>
			</div>
		</Section>

		<!-- Embedded vs. Advisory -->
		<Section>
			<h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-vg-burgundy">
				Embedded vs. Traditional Consulting
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				<!-- Traditional -->
				<div class="bg-gray-100 p-8 rounded-lg">
					<h3 class="text-2xl font-semibold mb-6 text-vg-gray-dark">Traditional Advisory</h3>
					<ul class="space-y-4 text-vg-gray-dark">
						<li class="flex items-start gap-3">
							<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M5 12h14"/></svg></span>
							<span>Observes from the outside</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M5 12h14"/></svg></span>
							<span>Delivers recommendations</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M5 12h14"/></svg></span>
							<span>Knowledge transfer through documents</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M5 12h14"/></svg></span>
							<span>Short engagements, limited context</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M5 12h14"/></svg></span>
							<span>Team still has to figure out implementation</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-gray-400 mt-1 flex-shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M5 12h14"/></svg></span>
							<span>Recommends AI tools without using them daily</span>
						</li>
					</ul>
				</div>

				<!-- Embedded -->
				<div class="bg-white p-8 rounded-lg border-2 border-vg-red shadow-lg">
					<h3 class="text-2xl font-semibold mb-6 text-vg-red">Embedded Engagement</h3>
					<ul class="space-y-4 text-vg-gray-dark">
						<li class="flex items-start gap-3">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Works alongside the team on real code</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Ships features and solves problems together</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Knowledge transfer through pairing and practice</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Deep context built over months</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Team grows stronger and more self-sufficient</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Brings daily experience with AI coding tools into the team's workflow</span>
						</li>
					</ul>
				</div>
			</div>
		</Section>

		<!-- Past Engagements -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold mb-4 text-center text-vg-burgundy">
				Proven in Practice
			</h2>
			<p class="text-lg text-vg-gray-dark text-center max-w-3xl mx-auto mb-12">
				Paul has done this work across industries, team sizes, and technology stacks. Today, every engagement includes AI-augmented development practices. Here are two examples from past work.
			</p>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				<div class="bg-white p-8 rounded-lg shadow-lg">
					<div class="flex items-center gap-3 mb-4">
						<span class="bg-vg-red/10 text-vg-red text-sm font-semibold px-3 py-1 rounded-full">IoT / Smart Home</span>
						<span class="text-vg-gray text-sm">Multiple engagements</span>
					</div>
					<h3 class="text-xl font-semibold mb-3 text-vg-burgundy">Large-Scale Domain Redesign</h3>
					<p class="text-vg-gray-dark mb-4">
						Embedded with a product engineering team at a Fortune 500 manufacturer, working on a large Ruby on Rails IoT platform. Led deep refactoring of the domain model across multiple bounded contexts, improving performance and aligning the code with the business language.
					</p>
					<p class="text-vg-gray-dark mb-4">
						The design insights from this engagement became the basis for two conference talks at Explore DDD and DDD Europe.
					</p>
					<div class="flex flex-wrap gap-3">
						<a href="/speaking" class="text-vg-red hover:text-vg-burgundy text-sm font-medium inline-flex items-center gap-1">
							Watch the talks
							<Icon name="arrow-right" size="sm" />
						</a>
					</div>
				</div>
				<div class="bg-white p-8 rounded-lg shadow-lg">
					<div class="flex items-center gap-3 mb-4">
						<span class="bg-vg-red/10 text-vg-red text-sm font-semibold px-3 py-1 rounded-full">Financial Services</span>
						<span class="text-vg-gray text-sm">11 months</span>
					</div>
					<h3 class="text-xl font-semibold mb-3 text-vg-burgundy">Financial Services Platform</h3>
					<p class="text-vg-gray-dark mb-4">
						Joined a financial services team for nearly a year, working on production systems handling sensitive financial data. Paired with developers daily, ran EventStorming sessions to map complex business processes, and helped the team adopt DDD practices that outlasted the engagement.
					</p>
					<p class="text-vg-gray-dark">
						This is what embedded means: long enough to understand the domain deeply, build real trust, and leave the team stronger than you found them.
					</p>
				</div>
			</div>
		</Section>

		<!-- Who This Is For -->
		<Section>
			<h2 class="text-3xl md:text-4xl font-bold mb-8 text-center text-vg-burgundy">
				Who This Is For
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				<div class="bg-gray-50 p-6 rounded-lg shadow">
					<h3 class="text-xl font-semibold mb-3 text-vg-red">Teams Adopting DDD</h3>
					<p class="text-vg-gray-dark">
						Learning Domain-Driven Design from books only goes so far. An experienced practitioner working alongside you accelerates adoption and helps avoid common pitfalls.
					</p>
				</div>
				<div class="bg-gray-50 p-6 rounded-lg shadow">
					<h3 class="text-xl font-semibold mb-3 text-vg-red">Teams Tackling Complex Domains</h3>
					<p class="text-vg-gray-dark">
						When the business logic is genuinely hard, an extra senior perspective on modeling and design decisions makes a real difference in the quality of the solution.
					</p>
				</div>
				<div class="bg-gray-50 p-6 rounded-lg shadow">
					<h3 class="text-xl font-semibold mb-3 text-vg-red">Teams Modernizing Legacy Systems</h3>
					<p class="text-vg-gray-dark">
						Strangler fig patterns, bounded context extraction, and incremental migration are easier with someone who has done it before working in the codebase with you.
					</p>
				</div>
				<div class="bg-gray-50 p-6 rounded-lg shadow">
					<h3 class="text-xl font-semibold mb-3 text-vg-red">Teams Building with AI Coding Tools</h3>
					<p class="text-vg-gray-dark">
						Tools like Claude Code, Copilot, and Cursor change how code gets written, but the real leverage is in design skills: knowing what to build, structuring code so AI can work with it, and reviewing generated output critically. Paul uses these tools daily and brings practical, team-tested workflows for AI-augmented development. Both <a href="/products/contextflow" class="text-vg-red hover:text-vg-burgundy font-medium">ContextFlow</a> and <a href="/products/codecohesion" class="text-vg-red hover:text-vg-burgundy font-medium">CodeCohesion</a> were built entirely with Claude Code using the same approaches he brings to your team.
					</p>
				</div>
			</div>
		</Section>

		<!-- How We Get Started -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-vg-burgundy">
				How We Get Started
			</h2>
			<div class="max-w-4xl mx-auto">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="text-center">
						<div class="w-12 h-12 bg-vg-red text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4">1</div>
						<h3 class="text-lg font-semibold mb-2 text-vg-burgundy">Conversation</h3>
						<p class="text-vg-gray-dark">
							We talk about your team's situation, the domain you're working in, and what you're trying to accomplish. No pitch, just a real conversation about fit.
						</p>
					</div>
					<div class="text-center">
						<div class="w-12 h-12 bg-vg-red text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4">2</div>
						<h3 class="text-lg font-semibold mb-2 text-vg-burgundy">Scope &amp; Structure</h3>
						<p class="text-vg-gray-dark">
							We define the weekly commitment, focus areas, and how Paul integrates with the team's existing workflow. Every engagement is different.
						</p>
					</div>
					<div class="text-center">
						<div class="w-12 h-12 bg-vg-red text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4">3</div>
						<h3 class="text-lg font-semibold mb-2 text-vg-burgundy">Start Working</h3>
						<p class="text-vg-gray-dark">
							Paul joins the team and starts contributing from day one. No long ramp-up period, no observation phase. Real work, right away.
						</p>
					</div>
				</div>
			</div>
		</Section>

		<!-- CTA -->
		<Section background="burgundy">
			<div class="text-center max-w-3xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-bold mb-6">Interested in Exploring an Embedded Engagement?</h2>
				<p class="text-xl mb-8 text-vg-gray-light">
					Every engagement is tailored to the team's situation, domain, and goals. Let's talk about whether this model is a good fit for your team.
				</p>
				<Button href="/contact" variant="primary" class="!px-8 !py-4 !bg-white !text-vg-burgundy hover:!bg-vg-gray-light">
					Schedule a Conversation
				</Button>
			</div>
		</Section>

		<BackToTop />
		<Footer />
	</body>
</html>
