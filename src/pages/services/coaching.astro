---
import BackToTop from '../../components/BackToTop.astro';
import BaseHead from '../../components/BaseHead.astro';
import Button from '../../components/Button.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import Section from '../../components/Section.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';

const title = 'Coaching & Consulting - Virtual Genius';
const description = 'A senior design partner for your team on a three-month term: working sessions on real features, design reviews between them, and guidance on Domain-Driven Design, EventStorming, and agentic development.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="bg-white">
		<Header />

		<!-- Hero with Collaboration Background -->
		<section class="relative w-full overflow-hidden" style="height: 360px;">
			<!-- Background Image -->
			<div class="absolute inset-0 w-full h-full">
				<img
					src="/images/workshop-collaboration.webp"
					alt="Workshop collaboration"
					class="w-full h-full object-cover"
					style="filter: brightness(0.6); object-position: center 40%;"
				/>
				<!-- Dark overlay for text readability -->
				<div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/30 to-black/50"></div>
			</div>

			<!-- Content Overlay -->
			<div class="relative z-10 flex items-center justify-center h-full">
				<div class="max-w-screen-xl mx-auto px-6 w-full">
					<div class="text-center max-w-4xl mx-auto">
						<h1 class="text-5xl md:text-7xl font-bold mb-6 text-white drop-shadow-lg">
							Coaching & Consulting
						</h1>
						<p class="text-2xl md:text-3xl mb-8 text-white/95 drop-shadow-md">
							A senior design partner for your team, working alongside you on the features that matter
						</p>
						<Button href="/contact" variant="primary">
							Discuss Your Needs
						</Button>
					</div>
				</div>
			</div>
		</section>

		<!-- Overview -->
		<Section>
			<div class="max-w-4xl mx-auto text-center">
				<p class="text-lg text-vg-gray-dark mb-6">
					Workshops and training build shared understanding. The hard part comes afterward, when the team is back on real features with real deadlines and the design questions get specific. Coaching gives your team someone to think with while they do that work: scheduled working sessions on your actual code and domain, design review between sessions, and a senior practitioner to call when the hard decisions come up.
				</p>
				<p class="text-xl font-semibold text-vg-red">
					We meet you where you are and help you move forward with confidence.
				</p>
			</div>
		</Section>

		<!-- Service Offerings -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-vg-burgundy">
				How We Can Help
			</h2>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
				<!-- Working Sessions -->
				<div class="bg-white p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-2xl font-semibold mb-4 text-vg-burgundy">Working Sessions on Real Features</h3>
					<p class="text-vg-gray-dark mb-4">
						Scheduled sessions with your team on the work in front of them. Not a lecture about patterns; modeling, designing, and pairing on the parts that are genuinely hard.
					</p>
					<h4 class="font-semibold text-vg-red mb-2">Includes:</h4>
					<ul class="space-y-2 text-vg-gray-dark">
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Collaborative modeling on your domain</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Pairing on challenging implementations</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Design guidance for bounded contexts</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Model refinement as you learn</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Creating reusable patterns the team owns</span>
						</li>
					</ul>
				</div>

				<!-- Code Reviews & Design Walkthroughs -->
				<div class="bg-white p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-2xl font-semibold mb-4 text-vg-burgundy">Code Reviews & Design Walkthroughs</h3>
					<p class="text-vg-gray-dark mb-4">
						Review of code, design decisions, and architectural choices through a DDD lens, between working sessions, so questions get answered while they are still cheap to act on.
					</p>
					<h4 class="font-semibold text-vg-red mb-2">Includes:</h4>
					<ul class="space-y-2 text-vg-gray-dark">
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Architecture and design feedback</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Domain model quality assessment</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Bounded context boundary evaluation</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>API and interface design reviews</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Actionable improvement recommendations</span>
						</li>
					</ul>
				</div>

				<!-- Agentic Development Practices -->
				<div class="bg-white p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-2xl font-semibold mb-4 text-vg-burgundy">Agentic Development Practices</h3>
					<p class="text-vg-gray-dark mb-4">
						AI coding tools amplify whatever practices a team already has. Coaching builds the design, specification, and review habits that make AI-generated code trustworthy.
					</p>
					<h4 class="font-semibold text-vg-red mb-2">Includes:</h4>
					<ul class="space-y-2 text-vg-gray-dark">
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Test-driven workflows with AI tools</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Specifying and reviewing instead of typing every line</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Structuring code so AI can work with it</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Design judgment applied to generated output</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Tooling-agnostic: the practices are what matter</span>
						</li>
					</ul>
				</div>

				<!-- Post-Workshop Follow-Through -->
				<div class="bg-white p-8 rounded-lg shadow-lg border-t-4 border-vg-red">
					<h3 class="text-2xl font-semibold mb-4 text-vg-burgundy">Post-Workshop Follow-Through</h3>
					<p class="text-vg-gray-dark mb-4">
						After an EventStorming workshop or DDD training, the insights are fresh and the backlog is not. Coaching turns what the team discovered into working software.
					</p>
					<h4 class="font-semibold text-vg-red mb-2">Includes:</h4>
					<ul class="space-y-2 text-vg-gray-dark">
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Reviewing and refining workshop outputs</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Breaking down identified work into stories</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Choosing the first bounded context to build</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Support during initial implementation</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="text-vg-red mt-1 flex-shrink-0">
								<Icon name="check" size="sm" />
							</span>
							<span>Focused EventStorming sessions when a new subdomain appears</span>
						</li>
					</ul>
				</div>
			</div>
		</Section>

		<!-- Engagement Levels -->
		<Section>
			<h2 class="text-3xl md:text-4xl font-bold mb-8 text-center text-vg-burgundy">
				Three Ways to Work Together
			</h2>
			<div class="max-w-5xl mx-auto text-center">
				<p class="text-lg text-vg-gray-dark mb-4">
					Every coaching engagement runs on a three-month term, with consistent, dedicated availability and mutually coordinated scheduling. The three levels differ in breadth and access, not in hours. Each builds on the one before it.
				</p>
				<p class="text-vg-gray-dark mb-10">
					We scope the outcomes together on a discovery call, and the proposal presents all three so you can choose the depth that fits.
				</p>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<div class="bg-vg-gray-light p-6 rounded-lg">
						<h3 class="text-xl font-semibold mb-3 text-vg-red">Focused</h3>
						<p class="text-vg-gray-dark mb-4 text-left">
							One team, or one design problem that matters. The right starting point when a team is applying DDD or EventStorming to a specific piece of work.
						</p>
						<ul class="text-sm text-vg-gray-dark text-left space-y-2">
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-0.5 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Scheduled working sessions on your real features</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-0.5 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Design and code review between sessions</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-0.5 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Async access for design questions as they come up</span>
							</li>
						</ul>
					</div>
					<div class="bg-vg-gray-light p-6 rounded-lg border-2 border-vg-red">
						<h3 class="text-xl font-semibold mb-3 text-vg-red">Accelerator</h3>
						<p class="text-vg-gray-dark mb-4 text-left">
							Everything in Focused, for a second team or a second stream of work, with a facilitated modeling session to open the engagement.
						</p>
						<ul class="text-sm text-vg-gray-dark text-left space-y-2">
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-0.5 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Two teams or two streams of work</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-0.5 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>EventStorming or design session to kick off</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-0.5 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Priority turnaround on async questions</span>
							</li>
						</ul>
					</div>
					<div class="bg-vg-gray-light p-6 rounded-lg">
						<h3 class="text-xl font-semibold mb-3 text-vg-red">Transformation Partner</h3>
						<p class="text-vg-gray-dark mb-4 text-left">
							Everything in Accelerator, plus a seat at the table with engineering leadership as the practices spread beyond the first teams.
						</p>
						<ul class="text-sm text-vg-gray-dark text-left space-y-2">
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-0.5 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Advisory on boundaries, roadmap, and architecture direction</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-0.5 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Practice adoption across teams</span>
							</li>
							<li class="flex items-start gap-2">
								<span class="text-vg-red mt-0.5 flex-shrink-0">
									<Icon name="check" size="sm" />
								</span>
								<span>Review with leadership at the end of the term</span>
							</li>
						</ul>
					</div>
				</div>
				<p class="text-vg-gray-dark mt-8">
					Need someone inside the team day to day rather than alongside it? See <a href="/services/embedded" class="text-vg-red hover:text-vg-burgundy font-medium">Embedded Team Engagements</a>.
				</p>
			</div>
		</Section>

		<!-- Typical Engagement -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold mb-8 text-center text-vg-burgundy">
				Typical Engagement Flow
			</h2>
			<div class="max-w-4xl mx-auto">
				<div class="space-y-6">
					<div class="flex items-start">
						<div class="bg-vg-red text-white text-xl font-bold rounded-full w-12 h-12 flex items-center justify-center mr-6 flex-shrink-0 mt-1">
							1
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">Discovery Call</h3>
							<p class="text-vg-gray-dark">
								We discuss your current situation, goals, and the specific challenges your team is facing.
							</p>
						</div>
					</div>
					<div class="flex items-start">
						<div class="bg-vg-red text-white text-xl font-bold rounded-full w-12 h-12 flex items-center justify-center mr-6 flex-shrink-0 mt-1">
							2
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">Proposal</h3>
							<p class="text-vg-gray-dark">
								Three options for a three-month term, each scoped around the outcomes we agreed on the call. You choose the depth.
							</p>
						</div>
					</div>
					<div class="flex items-start">
						<div class="bg-vg-red text-white text-xl font-bold rounded-full w-12 h-12 flex items-center justify-center mr-6 flex-shrink-0 mt-1">
							3
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">Kickoff Session</h3>
							<p class="text-vg-gray-dark">
								Initial working session to establish a baseline, review context, and align on goals.
							</p>
						</div>
					</div>
					<div class="flex items-start">
						<div class="bg-vg-red text-white text-xl font-bold rounded-full w-12 h-12 flex items-center justify-center mr-6 flex-shrink-0 mt-1">
							4
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">Working Sessions</h3>
							<p class="text-vg-gray-dark">
								Scheduled sessions with your team on a consistent cadence, with design review and async access between them.
							</p>
						</div>
					</div>
					<div class="flex items-start">
						<div class="bg-vg-red text-white text-xl font-bold rounded-full w-12 h-12 flex items-center justify-center mr-6 flex-shrink-0 mt-1">
							5
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-vg-burgundy">Review & Next Term</h3>
							<p class="text-vg-gray-dark">
								A look at what changed over the term, what the team now does on its own, and whether another term makes sense.
							</p>
						</div>
					</div>
				</div>
			</div>
		</Section>

		<!-- Who Benefits -->
		<Section>
			<h2 class="text-3xl md:text-4xl font-bold mb-8 text-center text-vg-burgundy">
				Who Benefits from Coaching?
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				<div class="bg-vg-gray-light p-6 rounded-lg">
					<h3 class="text-xl font-semibold mb-3 text-vg-red">Teams Post-EventStorming</h3>
					<p class="text-vg-gray-dark">
						Turn workshop insights into working software with confidence
					</p>
				</div>
				<div class="bg-vg-gray-light p-6 rounded-lg">
					<h3 class="text-xl font-semibold mb-3 text-vg-red">Teams New to DDD</h3>
					<p class="text-vg-gray-dark">
						Accelerate learning and avoid common pitfalls during initial adoption
					</p>
				</div>
				<div class="bg-vg-gray-light p-6 rounded-lg">
					<h3 class="text-xl font-semibold mb-3 text-vg-red">Teams Modernizing Legacy Systems</h3>
					<p class="text-vg-gray-dark">
						Apply DDD patterns strategically to existing codebases
					</p>
				</div>
				<div class="bg-vg-gray-light p-6 rounded-lg">
					<h3 class="text-xl font-semibold mb-3 text-vg-red">Teams Adopting AI-Assisted Development</h3>
					<p class="text-vg-gray-dark">
						Build the design and review discipline that keeps generated code from becoming technical debt
					</p>
				</div>
			</div>
		</Section>

		<!-- Testimonials -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-vg-burgundy">
				What Clients Say
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
				<TestimonialCard
					quote="Use an anti-corruption layer to translate between domains, design domains to reflect the business process but also allow bounded contexts to emerge over time as the product evolves"
					role="Software Developer"
					industry="Technology"
					rating={10}
					workshop="Essential DDD"
				/>
				<TestimonialCard
					quote="I love the insights I got from discussions with the group and am excited to take this back to my team and try some ideas out."
					role="Workshop Participant"
					industry="Public Workshop"
					rating={10}
					workshop="EventStorming Facilitation"
				/>
				<TestimonialCard
					quote="'- New techniques for making Event Storming valuable for different purposes, especially done virtually - Ideas for talking about context mapping and domain distillation in a way that is purposeful and resonates with a broader group"
					role="Workshop Participant"
					industry="Technology"
					rating={10}
					workshop="Strategic DDD"
				/>
			</div>
			<div class="text-center mt-8">
				<a href="/testimonials" class="text-vg-red hover:text-vg-red-light font-semibold text-lg">
					View All Testimonials <Icon name="arrow-right" size="sm" />
				</a>
			</div>
		</Section>

		<!-- Pricing CTA -->
		<Section background="burgundy">
			<div class="text-center max-w-3xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-bold mb-6">Let's Discuss Your Challenges</h2>
				<p class="text-xl mb-8 text-vg-gray-light">
					Every team's situation is unique. Contact us to talk through where your team is and which level fits.
				</p>
				<Button href="/contact" variant="primary" class="!px-8 !py-4 !bg-white !text-vg-burgundy hover:!bg-vg-gray-light">
					Schedule a Discovery Call
				</Button>
			</div>
		</Section>

		<BackToTop />
		<Footer />
	</body>
</html>
