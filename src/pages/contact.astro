---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import Section from '../components/Section.astro';
import { SITE_TITLE } from '../consts';

const title = `Contact | ${SITE_TITLE}`;
const description = 'Get in touch with Virtual Genius for EventStorming workshops, DDD training, or coaching services.';
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="bg-white">
		<Header />

		<!-- Hero with Collaboration Background -->
		<section class="relative w-full overflow-hidden" style="height: 360px;">
			<!-- Background Image -->
			<div class="absolute inset-0 w-full h-full">
				<img
					src="/images/bti360-participants-collaborating.webp"
					alt="Team collaborating"
					class="w-full h-full object-cover"
					style="filter: brightness(0.6); object-position: center 40%;"
				/>
				<!-- Dark overlay for text readability -->
				<div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/30 to-black/50"></div>
			</div>

			<!-- Content Overlay -->
			<div class="relative z-10 flex items-center justify-center h-full">
				<div class="max-w-screen-xl mx-auto px-6 w-full">
					<div class="text-center max-w-4xl mx-auto">
						<h1 class="text-5xl md:text-7xl font-bold mb-6 text-white drop-shadow-lg">
							Get in Touch
						</h1>
						<p class="text-2xl md:text-3xl mb-8 text-white/95 drop-shadow-md">
							Ready to explore EventStorming, DDD training, or coaching for your team? Let's start a conversation.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact Form + Social -->
		<Section>
			<div class="max-w-4xl mx-auto">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
					<!-- Contact Form -->
					<div class="md:col-span-2">
						<h2 class="text-2xl font-semibold mb-6 text-vg-burgundy">Send a Message</h2>

						{web3formsKey ? (
							<form action="https://api.web3forms.com/submit" method="POST" class="space-y-5" id="contact-form">
								<input type="hidden" name="access_key" value={web3formsKey} />
								<input type="hidden" name="subject" value="New contact from virtualgenius.com" />
								<input type="hidden" name="from_name" value="Virtual Genius Website" />
								<!-- Honeypot spam protection -->
								<input type="checkbox" name="botcheck" class="hidden" style="display:none" />

								<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
									<div>
										<label for="name" class="block text-sm font-semibold text-vg-gray-dark mb-1">Name</label>
										<input
											type="text"
											id="name"
											name="name"
											required
											class="w-full px-4 py-3 border border-vg-gray rounded-lg focus:outline-none focus:ring-2 focus:ring-vg-red focus:border-transparent transition-colors"
											placeholder="Your name"
										/>
									</div>
									<div>
										<label for="email" class="block text-sm font-semibold text-vg-gray-dark mb-1">Email</label>
										<input
											type="email"
											id="email"
											name="email"
											required
											class="w-full px-4 py-3 border border-vg-gray rounded-lg focus:outline-none focus:ring-2 focus:ring-vg-red focus:border-transparent transition-colors"
											placeholder="you@company.com"
										/>
									</div>
								</div>

								<div>
									<label for="interest" class="block text-sm font-semibold text-vg-gray-dark mb-1">Service Interest</label>
									<select
										id="interest"
										name="interest"
										class="w-full px-4 py-3 border border-vg-gray rounded-lg focus:outline-none focus:ring-2 focus:ring-vg-red focus:border-transparent transition-colors bg-white"
									>
										<option value="">What are you interested in?</option>
										<option value="EventStorming Workshop">EventStorming Workshop</option>
										<option value="DDD Training">DDD Training</option>
										<option value="Coaching & Consulting">Coaching & Consulting</option>
										<option value="Embedded Team Engagement">Embedded Team Engagement</option>
										<option value="Speaking Engagement">Speaking Engagement</option>
										<option value="Other">Other</option>
									</select>
								</div>

								<div>
									<label for="message" class="block text-sm font-semibold text-vg-gray-dark mb-1">Message</label>
									<textarea
										id="message"
										name="message"
										required
										rows="5"
										class="w-full px-4 py-3 border border-vg-gray rounded-lg focus:outline-none focus:ring-2 focus:ring-vg-red focus:border-transparent transition-colors resize-y"
										placeholder="Tell us about your team, the challenges you're facing, and what you hope to achieve. Any timeline or constraints are helpful too."
									></textarea>
								</div>

								<div>
									<button
										type="submit"
										class="inline-flex items-center justify-center rounded-lg font-semibold transition-all duration-200 px-8 py-3 bg-vg-red text-white hover:bg-vg-red-light shadow-lg hover:shadow-xl"
									>
										Send Message
										<Icon name="arrow-right" size="sm" class="ml-2" />
									</button>
								</div>

								<!-- Success/Error messages -->
								<div id="form-success" class="hidden p-4 bg-green-50 border border-green-200 rounded-lg text-green-800">
									Thanks for reaching out! We'll get back to you within 1 business day.
								</div>
								<div id="form-error" class="hidden p-4 bg-red-50 border border-red-200 rounded-lg text-red-800">
									Something went wrong. Please try emailing us directly at <a href="mailto:info@virtualgenius.com" class="underline font-semibold">info@virtualgenius.com</a>.
								</div>
							</form>
						) : (
							<div class="p-6 bg-vg-gray-light rounded-lg">
								<p class="text-vg-gray-dark mb-4">
									Send us an email and we'll get back to you within 1 business day.
								</p>
								<a
									href="mailto:info@virtualgenius.com"
									class="text-xl font-semibold text-vg-red hover:text-vg-red-light"
								>
									info@virtualgenius.com
								</a>
							</div>
						)}
					</div>

					<!-- Social & Direct Email -->
					<div>
						<h2 class="text-2xl font-semibold mb-6 text-vg-burgundy">Connect Online</h2>
						<p class="text-vg-gray-dark mb-4">
							Follow along and connect with Paul on social media.
						</p>
						<div class="flex flex-col space-y-3 mb-8">
							<a
								href="https://www.linkedin.com/in/thepaulrayner/"
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center text-vg-red hover:text-vg-red-light font-semibold"
							>
								<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
									<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
								</svg>
								LinkedIn
							</a>
							<a
								href="https://bsky.app/profile/paulrayner.bsky.social"
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center text-vg-red hover:text-vg-red-light font-semibold"
							>
								<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 576 512">
									<path d="M407.8 294.7c-3.3-.4-6.7-.8-10-1.3 3.4.4 6.7.9 10 1.3zM288 227.1C261.9 176.4 190.9 81.9 124.9 35.3 61.6-9.4 37.5-1.7 21.6 5.5 3.3 13.8 0 41.9 0 58.4S9.1 194 15 213.9c19.5 65.7 89.1 87.9 153.2 80.7 3.3-.5 6.6-.9 10-1.4-3.3.5-6.6 1-10 1.4C60.2 306.3 1 323.5 1 401.7 1 498 158.8 528.2 288 512c129.2 16.2 287-14 287-110.3 0-78.2-59.2-95.4-167.2-107.4-3.3-.4-6.7-.8-10-1.3 3.4.4 6.7.9 10 1.3 64.1 7.1 133.7-15.1 153.2-80.7C567 194 576 58.4 576 58.4c0-16.5-3.3-44.6-21.6-52.9-15.9-7.2-40-14.9-103.3 29.8C385.1 81.9 314.1 176.4 288 227.1z"/>
								</svg>
								Bluesky
							</a>
							<a
								href="https://github.com/paulrayner"
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center text-vg-red hover:text-vg-red-light font-semibold"
							>
								<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
								</svg>
								GitHub
							</a>
						</div>

						<div class="border-t border-vg-gray-light pt-6">
							<h3 class="text-lg font-semibold mb-3 text-vg-burgundy">Prefer email?</h3>
							<p class="text-vg-gray-dark mb-3 text-sm">
								You can also reach us directly at:
							</p>
							<a
								href="mailto:info@virtualgenius.com"
								class="text-vg-red hover:text-vg-red-light font-semibold"
							>
								info@virtualgenius.com
							</a>
						</div>
					</div>
				</div>
			</div>
		</Section>

		<!-- Quick Links -->
		<Section background="gray">
			<h2 class="text-3xl md:text-4xl font-bold mb-8 text-center text-vg-burgundy">
				Explore Our Services
			</h2>
			<div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
				<a
					href="/services/eventstorming"
					class="bg-white p-6 rounded-lg hover:shadow-lg transition-shadow duration-200 block text-center"
				>
					<h3 class="text-xl font-semibold mb-3 text-vg-burgundy">EventStorming Workshops</h3>
					<p class="text-vg-gray-dark mb-4">
						2-day facilitated sessions for exploring complex domains
					</p>
					<span class="inline-flex items-center gap-1 text-vg-red font-semibold">
						Learn More
						<Icon name="arrow-right" size="sm" />
					</span>
				</a>
				<a
					href="/services/training"
					class="bg-white p-6 rounded-lg hover:shadow-lg transition-shadow duration-200 block text-center"
				>
					<h3 class="text-xl font-semibold mb-3 text-vg-burgundy">DDD Training</h3>
					<p class="text-vg-gray-dark mb-4">
						Essential and Strategic Domain-Driven Design courses
					</p>
					<span class="inline-flex items-center gap-1 text-vg-red font-semibold">
						Learn More
						<Icon name="arrow-right" size="sm" />
					</span>
				</a>
				<a
					href="/services/coaching"
					class="bg-white p-6 rounded-lg hover:shadow-lg transition-shadow duration-200 block text-center"
				>
					<h3 class="text-xl font-semibold mb-3 text-vg-burgundy">Coaching & Consulting</h3>
					<p class="text-vg-gray-dark mb-4">
						Ongoing support for pilot projects and implementation
					</p>
					<span class="inline-flex items-center gap-1 text-vg-red font-semibold">
						Learn More
						<Icon name="arrow-right" size="sm" />
					</span>
				</a>
			</div>
		</Section>

		<!-- Other Resources -->
		<Section>
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-3xl md:text-4xl font-bold mb-6 text-vg-burgundy">
					Additional Resources
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<a
						href="/products"
						class="bg-vg-gray-light p-6 rounded-lg hover:shadow-lg transition-shadow duration-200 block"
					>
						<h3 class="text-xl font-semibold mb-3 text-vg-burgundy">Open Source Products</h3>
						<p class="text-vg-gray-dark mb-4">
							Explore ContextFlow and CodeCohesion, our free DDD visualization tools
						</p>
						<span class="inline-flex items-center gap-1 text-vg-red font-semibold">
							View Products
							<Icon name="arrow-right" size="sm" />
						</span>
					</a>
					<a
						href="/blog"
						class="bg-vg-gray-light p-6 rounded-lg hover:shadow-lg transition-shadow duration-200 block"
					>
						<h3 class="text-xl font-semibold mb-3 text-vg-burgundy">Blog</h3>
						<p class="text-vg-gray-dark mb-4">
							Read our latest insights on DDD, EventStorming, and software design
						</p>
						<span class="inline-flex items-center gap-1 text-vg-red font-semibold">
							Read Blog
							<Icon name="arrow-right" size="sm" />
						</span>
					</a>
				</div>
				<div class="mt-8">
					<p class="text-vg-gray-dark">
						For more personal content from Paul, visit
						<a
							href="https://thepaulrayner.com"
							target="_blank"
							rel="noopener noreferrer"
							class="text-vg-red hover:text-vg-red-light font-semibold"
						>
							thepaulrayner.com
						</a>
					</p>
				</div>
			</div>
		</Section>

		<Footer />

		<script>
			const form = document.getElementById('contact-form') as HTMLFormElement | null;
			if (form) {
				form.addEventListener('submit', async (e) => {
					e.preventDefault();
					const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
					const successEl = document.getElementById('form-success');
					const errorEl = document.getElementById('form-error');

					submitBtn.disabled = true;
					submitBtn.textContent = 'Sending...';
					successEl?.classList.add('hidden');
					errorEl?.classList.add('hidden');

					try {
						const response = await fetch(form.action, {
							method: 'POST',
							body: new FormData(form),
						});
						const data = await response.json();

						if (data.success) {
							form.reset();
							successEl?.classList.remove('hidden');
							form.querySelectorAll('input, textarea, select, button').forEach((el) => {
								(el as HTMLInputElement).disabled = true;
							});
						} else {
							errorEl?.classList.remove('hidden');
						}
					} catch {
						errorEl?.classList.remove('hidden');
					} finally {
						submitBtn.disabled = false;
						submitBtn.textContent = 'Send Message';
					}
				});
			}
		</script>
	</body>
</html>
